# Copy to .env and fill in your own Supabase project's values.
# .env is gitignored; this example file is not.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Not read by the frontend. Set as a Supabase secret so the edge functions
# can reach the Hugging Face Inference API:
#   supabase secrets set HUGGINGFACE_API_KEY=hf_xxx
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# into edge functions automatically — do not set them here.
